<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginHorizontal="32dp"
    android:layout_marginVertical="18dp"
    android:padding="8dp"
    android:background="@drawable/bg_card"
    android:layoutDirection="rtl">

    <TextView
        android:id="@+id/tvProjectName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="הפרויקט הראשון שלי"
        android:textAlignment="textStart"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:fontFamily="@font/google_sans"
        android:textStyle="bold"
        android:textSize="16sp"
        />
    <TextView
        android:id="@+id/tvProjectDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="היה היה פעם לורם איפסום דולור סיט אמט, שהחליט שנמאס לו להיות סתם ממלא מקום באתרי אינטרנט. הוא קם בבוקר, שתה כוס קונסקטורר אדיפיסינג אלית, ויצא לטיול אלמנקום ניסי נון ניבאה הגדול. בדרך הוא פגש את קוואזי במר, מודוף זקן וחביב שמכר בלאסטיק מונופץ קליר בחצי מחיר."
        android:maxLines="4"
        android:ellipsize="end"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvProjectName"/>
    <ImageView
        android:id="@+id/imgtypeChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvProjectDescription"
        android:src="@drawable/elm_private_chip"
        android:layout_marginTop="57dp"/>
    <ImageView
        android:id="@+id/imgSensor1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/img_temphum_1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <ImageView
        android:id="@+id/imgSensor2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/img_led_2"
        app:layout_constraintEnd_toStartOf="@id/imgSensor1"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginEnd="6dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>