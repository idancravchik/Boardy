<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:layout_marginRight="8dp"
        android:clickable="true"
        android:src="@drawable/ic_back"
        app:layout_constraintBottom_toBottomOf="@+id/textView"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_marginRight="4dp"
        android:gravity="center_vertical"
        android:text="העלאת תוכנה"
        android:textColor="#000000"
        android:textSize="22sp"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/btnBack"
        app:layout_constraintTop_toTopOf="parent" />



    <ViewFlipper
        android:id="@+id/vfUploader"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/btnBack"
        app:layout_constraintBottom_toBottomOf="parent">
        <!--שלב 1 + 2, ניהול והמתנה לחיבור הלוח-->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/sd_card"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_sd_card"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/projectName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/reisinger_michal"
                android:text="התוכנה הראשונה שלי"
                android:textSize="24sp"
                android:textColor="@color/gray_900"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/sd_card"
                android:layout_marginTop="94dp"/>

            <ImageView
                android:id="@+id/imgloader"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/avd_upload_loader"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sd_card" />
            <TextView
                android:id="@+id/tvLoaderText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/reisinger_michal"
                android:text="ממתין לחיבור הלוח..."
                android:textSize="20sp"
                android:textStyle="italic"
                android:textColor="@color/gray_900"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/imgloader"
                android:layout_marginTop="16dp"/>


        </androidx.constraintlayout.widget.ConstraintLayout>
        <!--שלב 3, הכפתור של ההעלאת קוד והתהליך העלאה-->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/clUploader3">
            <Button
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/btntest"
                android:onClick="finishLoader"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>


            <ImageView
                android:id="@+id/btUpload"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/avd_upload_hold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.288" />

            <TextView
                android:id="@+id/tvUpload"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btUpload"
                android:text="לחץ כדי להעלות"
                android:textSize="36sp"
                android:fontFamily="@font/reisinger_michal"
                android:textColor="@color/gray_900"/>


        </androidx.constraintlayout.widget.ConstraintLayout>
        <!--שלב 4, הסיום וכפתורי חזרה לתפריט-->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clUploader4"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/imgUploadFinish"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_upload_finish_full"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.288" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/imgUploadFinish"
                android:text="ההעלאה הושלמה"
                android:textSize="36sp"
                android:fontFamily="@font/reisinger_michal"
                android:textColor="@color/gray_900"/>

            <com.example.devbox.ui.DepthButton
                android:id="@+id/btnConsole"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:fontFamily="@font/google_sans"
                android:text="למסוף התוכנה"
                android:textColor="@color/gray_900"
                android:textSize="20sp"
                android:textStyle="bold"
                app:db_cornerRadius="14dp"
                app:db_depth="6dp"
                app:db_faceColor="@color/white_1000"
                app:db_shadowColor="@color/green_500"
                app:db_strokeColor="@color/green_500"
                app:db_strokeWidth="2dp"
                app:layout_constraintBottom_toTopOf="@+id/btnHome"
                app:layout_constraintEnd_toEndOf="@+id/btnHome"
                app:layout_constraintStart_toStartOf="@+id/btnHome" />

            <com.example.devbox.ui.DepthButton
                android:id="@+id/btnHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/google_sans"
                android:text="חזרה למסך הבית"
                android:textColor="@color/gray_900"
                android:textSize="20sp"
                android:textStyle="bold"
                app:db_cornerRadius="14dp"
                app:db_depth="6dp"
                app:db_faceColor="@color/white_1000"
                app:db_shadowColor="@color/red_500"
                app:db_strokeColor="@color/red_500"
                app:db_strokeWidth="2dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginBottom="64dp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>


    </ViewFlipper>
</androidx.constraintlayout.widget.ConstraintLayout>