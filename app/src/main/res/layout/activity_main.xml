<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:layoutDirection="rtl"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="200dp"
        android:fontFamily="@font/reisinger_michal"
        android:rotation="7"
        android:text="מוכן להתחיל ליצור?"
        android:textAlignment="center"
        android:textColor="@color/gray_900"
        android:textSize="40sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.example.devbox.ui.DepthButton
        android:id="@+id/btnDashboards"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/google_sans"
        android:text="לוחות בקרה"
        android:textColor="@color/gray_900"
        android:textSize="18sp"
        android:textStyle="bold"
        app:db_cornerRadius="14dp"
        app:db_depth="6dp"
        app:db_faceColor="@color/white_1000"
        app:db_shadowColor="@color/green_500"
        app:db_strokeColor="@color/green_500"
        app:db_strokeWidth="2dp"
        app:layout_constraintEnd_toEndOf="@+id/btnMyProjectsPublicProjects"
        app:layout_constraintStart_toStartOf="@+id/btnMyProjectsPublicProjects"
        app:layout_constraintTop_toBottomOf="@+id/btnMyProjectsPublicProjects" />

    <com.example.devbox.ui.DepthButton
        android:id="@+id/btnNew"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/google_sans"
        android:text="פרויקט חדש"
        android:textColor="@color/gray_900"
        android:textSize="18sp"
        android:textStyle="bold"
        app:db_cornerRadius="14dp"
        app:db_depth="6dp"
        app:db_faceColor="@color/white_1000"
        app:db_shadowColor="@color/blue_500"
        app:db_strokeColor="@color/blue_500"
        app:db_strokeWidth="2dp"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toEndOf="@+id/btnMyProjectsPublicProjects"
        app:layout_constraintStart_toStartOf="@+id/btnMyProjectsPublicProjects"
        app:layout_constraintTop_toBottomOf="@+id/textView2" />

    <com.example.devbox.ui.DepthButton
        android:id="@+id/btnMyProjects"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/google_sans"
        android:text="הפרויקטים שלי"
        android:textColor="@color/gray_900"
        android:textSize="18sp"
        android:textStyle="bold"
        app:db_cornerRadius="14dp"
        app:db_depth="6dp"
        app:db_faceColor="@color/white_1000"
        app:db_shadowColor="@color/red_500"
        app:db_strokeColor="@color/red_500"
        app:db_strokeWidth="2dp"
        app:layout_constraintEnd_toEndOf="@+id/btnMyProjectsPublicProjects"
        app:layout_constraintStart_toStartOf="@+id/btnMyProjectsPublicProjects"
        app:layout_constraintTop_toBottomOf="@+id/btnNew" />

    <com.example.devbox.ui.DepthButton
        android:id="@+id/btnMyProjectsPublicProjects"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/google_sans"
        android:text="פרויקטים ציבוריים"
        android:textColor="@color/gray_900"
        android:textSize="18sp"
        android:textStyle="bold"
        app:db_cornerRadius="14dp"
        app:db_depth="6dp"
        app:db_faceColor="@color/white_1000"
        app:db_shadowColor="@color/yellow_500"
        app:db_strokeColor="@color/yellow_500"
        app:db_strokeWidth="2dp"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnMyProjects" />

    <com.example.devbox.ui.DepthButton
        android:id="@+id/btnLogout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="40dp"
        android:fontFamily="@font/google_sans"
        android:text="התנתק"
        android:textSize="16sp"
        app:db_cornerRadius="15000dp"
        app:db_depth="6dp"
        app:db_faceColor="@color/white_1000"
        app:db_shadowColor="@color/red_500"
        app:db_strokeColor="@color/red_500"
        app:db_strokeWidth="2dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <TextView
        android:id="@+id/tvFullname"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="start"
        tools:text="שם של מישהו"
        android:layout_marginTop="40dp"
        android:layout_marginStart="16dp"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/tvSchool"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="start"
        tools:text="בית ספר של מישהו"
        android:layout_marginTop="2dp"
        android:layout_marginStart="16dp"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvFullname"/>



</androidx.constraintlayout.widget.ConstraintLayout>
