<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="368dp"
        android:fontFamily="@font/reisinger_michal"
        android:rotation="10.8"
        android:text="מוכן להתחיל ליצור?"
        android:textAlignment="center"
        android:textColor="#202124"
        android:textSize="40dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.example.devbox.ui.DepthButton
        android:id="@+id/btnDashboards"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="52dp"
        android:layout_marginTop="204dp"
        android:fontFamily="@font/google_sans"
        android:rotation="-20.75"
        android:text="לוחות בקרה"
        android:textColor="#202124"
        android:textSize="18sp"
        android:textStyle="bold"
        app:db_cornerRadius="14dp"
        app:db_depth="6dp"
        app:db_faceColor="#FFFFFF"
        app:db_shadowColor="#58A65C"
        app:db_strokeColor="#58A65C"
        app:db_strokeWidth="2dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.example.devbox.ui.DepthButton
        android:id="@+id/btnNew"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="204dp"
        android:layout_marginTop="276dp"
        android:fontFamily="@font/google_sans"
        android:rotation="15.35"
        android:text="פרויקט חדש"
        android:textColor="#202124"
        android:textSize="18sp"
        android:textStyle="bold"
        app:db_cornerRadius="14dp"
        app:db_depth="6dp"
        app:db_faceColor="#FFFFFF"
        app:db_shadowColor="#5383EC"
        app:db_strokeColor="#5383EC"
        app:db_strokeWidth="2dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.example.devbox.ui.DepthButton
        android:id="@+id/btnMyProjects"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="44dp"
        android:layout_marginTop="432dp"
        android:fontFamily="@font/google_sans"
        android:rotation="11.51"
        android:text="הפרויקטים שלי"
        android:textColor="#202124"
        android:textSize="18sp"
        android:textStyle="bold"
        app:db_cornerRadius="14dp"
        app:db_depth="6dp"
        app:db_faceColor="#FFFFFF"
        app:db_shadowColor="#D85140"
        app:db_strokeColor="#D85140"
        app:db_strokeWidth="2dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.example.devbox.ui.DepthButton
        android:id="@+id/btnMyProjectsPublicProjects"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="156dp"
        android:layout_marginTop="508dp"
        android:fontFamily="@font/google_sans"
        android:rotation="-24.11"
        android:text="פרויקטים ציבוריים"
        android:textColor="#202124"
        android:textSize="18sp"
        android:textStyle="bold"
        app:db_cornerRadius="14dp"
        app:db_depth="6dp"
        app:db_faceColor="#FFFFFF"
        app:db_shadowColor="#F1BF42"
        app:db_strokeColor="#F1BF42"
        app:db_strokeWidth="2dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.example.devbox.ui.DepthButton
        android:id="@+id/btnLogout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="40dp"
        android:fontFamily="@font/google_sans"
        android:icon="@drawable/door_open"
        app:db_iconSize="34dp"
        app:db_iconTint="#D85140"

        app:db_cornerRadius="15000dp"
        app:db_depth="6dp"
        app:db_faceColor="#FFFFFF"
        app:db_shadowColor="#D85140"
        app:db_strokeColor="#D85140"
        app:db_strokeWidth="2dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
