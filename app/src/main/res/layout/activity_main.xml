<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="368dp"
        android:fontFamily="@font/reisinger_michal"
        android:rotation="10.8"
        android:text="מוכן להתחיל ליצור?"
        android:textAlignment="center"
        android:textColor="@color/gray_900"
        android:textSize="40dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.example.devbox.ui.DepthButton
        android:id="@+id/btnDashboards"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="52dp"
        android:layout_marginTop="204dp"
        android:fontFamily="@font/google_sans"
        android:rotation="-20.75"
        android:text="לוחות בקרה"
        android:textColor="@color/gray_900"
        android:textSize="18sp"
        android:textStyle="bold"
        app:db_cornerRadius="14dp"
        app:db_depth="6dp"
        app:db_faceColor="@color/white_1000"
        app:db_shadowColor="@color/green_500"
        app:db_strokeColor="@color/green_500"
        app:db_strokeWidth="2dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.example.devbox.ui.DepthButton
        android:id="@+id/btnNew"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="204dp"
        android:layout_marginTop="276dp"
        android:fontFamily="@font/google_sans"
        android:rotation="15.35"
        android:text="פרויקט חדש"
        android:textColor="@color/gray_900"
        android:textSize="18sp"
        android:textStyle="bold"
        app:db_cornerRadius="14dp"
        app:db_depth="6dp"
        app:db_faceColor="@color/white_1000"
        app:db_shadowColor="@color/blue_500"
        app:db_strokeColor="@color/blue_500"
        app:db_strokeWidth="2dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.example.devbox.ui.DepthButton
        android:id="@+id/btnMyProjects"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="44dp"
        android:layout_marginTop="432dp"
        android:fontFamily="@font/google_sans"
        android:rotation="11.51"
        android:text="הפרויקטים שלי"
        android:textColor="@color/gray_900"
        android:textSize="18sp"
        android:textStyle="bold"
        app:db_cornerRadius="14dp"
        app:db_depth="6dp"
        app:db_faceColor="@color/white_1000"
        app:db_shadowColor="@color/red_500"
        app:db_strokeColor="@color/red_500"
        app:db_strokeWidth="2dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.example.devbox.ui.DepthButton
        android:id="@+id/btnMyProjectsPublicProjects"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="156dp"
        android:layout_marginTop="508dp"
        android:fontFamily="@font/google_sans"
        android:rotation="-24.11"
        android:text="פרויקטים ציבוריים"
        android:textColor="@color/gray_900"
        android:textSize="18sp"
        android:textStyle="bold"
        app:db_cornerRadius="14dp"
        app:db_depth="6dp"
        app:db_faceColor="@color/white_1000"
        app:db_shadowColor="@color/yellow_500"
        app:db_strokeColor="@color/yellow_500"
        app:db_strokeWidth="2dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.example.devbox.ui.DepthButton
        android:id="@+id/btnLogout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="40dp"
        android:fontFamily="@font/google_sans"
        android:text="התנתק"
        android:textSize="16sp"
        app:db_cornerRadius="15000dp"
        app:db_depth="6dp"
        app:db_faceColor="@color/white_1000"
        app:db_shadowColor="@color/red_500"
        app:db_strokeColor="@color/red_500"
        app:db_strokeWidth="2dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />



</androidx.constraintlayout.widget.ConstraintLayout>
